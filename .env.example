# Copy to .env. Local development works without external service credentials.
NODE_ENV=development
PORT=3001
PUBLIC_URL=http://localhost:5173
DATABASE_PATH=storage/gtech.sqlite
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=250

# The simulated checkout is local-only and is always disabled in production.
ENABLE_DEV_CHECKOUT=true

# Add your own Stripe TEST keys to test the real Stripe checkout.
# Never prefix server secrets with VITE_. Never commit .env.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set 1 only if your deployment is behind exactly one trusted reverse proxy.
TRUST_PROXY=0